{
  "name": "pizza-house-divinopolis",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Pizza House — pizzaria artesanal em Divinópolis, MG.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx --yes serve@14 out -l 3000",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/optimize-images.mjs && tsx scripts/build-illustrations.tsx",
    "photos": "python3 scripts/prepare_photos.py && npm run images",
    "illustrations": "tsx scripts/build-illustrations.tsx",
    "pacote": "NEXT_PUBLIC_RELATIVE_ASSETS=1 next build && node scripts/package-site.mjs && next build"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
